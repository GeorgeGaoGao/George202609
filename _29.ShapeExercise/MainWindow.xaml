<Window x:Class="_29.ShapeExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_29.ShapeExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel>
             <Ellipse Fill="Orange" Width="100" Height="50">
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard >
                            <DoubleAnimation Storyboard.TargetProperty="(Ellipse.Width)" Duration="0:0:2" To="200" AutoReverse="True" RepeatBehavior="Forever"/>

                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
            <Line Name="myLine" X1="50" Y1="10" X2="250" Y2="250" Stroke="Red" 
                  StrokeDashArray="3 2" StrokeDashCap="Round" 
                  StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Triangle">
                <!--<Line.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation From="0" To="-5" Duration="0:0:0.5"
                                                 RepeatBehavior="Forever"
                                                 Storyboard.TargetProperty="(Line.StrokeDashOffset)"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Line.Triggers>-->
            </Line>
        </StackPanel>
       
    </Grid>
</Window>

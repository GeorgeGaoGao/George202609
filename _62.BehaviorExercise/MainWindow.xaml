<Window x:Class="_62.BehaviorExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_62.BehaviorExercise" 
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <Button Content="GlowHover" Width="200" Height="40">
            <b:Interaction.Behaviors>
                <local:HoverGlowBehavior/>
                <local:DragBehavior/>
            </b:Interaction.Behaviors>
        </Button>
        <Ellipse Width="200" Height="200" StrokeThickness="1" Fill="Green">
            <b:Interaction.Behaviors>
                <local:HoverGlowBehavior/>
                <local:DragBehavior/>
            </b:Interaction.Behaviors>
        </Ellipse>
        <TextBlock Text="这是关于文字块的行为" FontSize="30" HorizontalAlignment="Center">
            <b:Interaction.Behaviors>
                <local:TextBlockShadowBehavior/>
            </b:Interaction.Behaviors>
        </TextBlock>
        <Button Content="try this" HorizontalAlignment="Center">
            <b:Interaction.Behaviors>
                <local:TextBlockShadowBehavior/>
            </b:Interaction.Behaviors>
        </Button>
        <Rectangle Width="100" Height="100" Stroke="Red" Fill="Red">
            <b:Interaction.Behaviors>
                <local:DragBehavior/>
            </b:Interaction.Behaviors>
        </Rectangle>

        <Canvas Width="300" Height="300">

        </Canvas>
    </StackPanel>
</Window>

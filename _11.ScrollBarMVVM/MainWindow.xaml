<Window x:Class="_11.ScrollBarMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_11.ScrollBarMVVM" xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"  
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <b:Interaction.Triggers>
        <b:EventTrigger EventName="SizeChanged">
            <b:InvokeCommandAction Command="{Binding }"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>
    <Grid Width="{Binding GridWidth}">
        <b:Interaction.Triggers>
            <b:EventTrigger EventName="Loaded">
                <b:InvokeCommandAction Command="{Binding GridLoadedCommand}" PassEventArgsToCommand="True"/>
            </b:EventTrigger>
        </b:Interaction.Triggers>
        <Grid.RowDefinitions>
            <RowDefinition Height="300"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Canvas >
            <StackPanel Loaded="StackPanel_Loaded"  Orientation="Horizontal">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SizeChanged">
                        <b:InvokeCommandAction Command=""/>
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
                <Border BorderBrush="Green" BorderThickness="1" Margin="3">
                    <Image Source="/Images/002.jpg" Margin="3"/>
                </Border>
            </StackPanel>
        </Canvas>
        <ScrollBar  Grid.Row="1" Height="20" Margin="10" VerticalAlignment="Top" Orientation="Horizontal"/>
    </Grid>
</Window>

<Window x:Class="_20.ListBoxExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_20.ListBoxExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ListBox Name="myListBox" DisplayMemberPath="Name" SelectedValuePath="Name"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="3">
            <Button Content="查看结果" Click="Button_Click"/>
            <TextBlock Name="myTextBlock"/>
        </StackPanel>
    </Grid>
</Window>

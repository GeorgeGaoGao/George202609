<Window x:Class="_02.PanelExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_02.PanelExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!--top-->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="DarkCyan" >
            <TextBlock DockPanel.Dock="Left" Text="WPF工业系统" FontSize="30" HorizontalAlignment="Left" Margin="10"/>
            <Border CornerRadius="10" Width="80" Height="30" Background="Orange" HorizontalAlignment="Right" Margin="0 0 40 0">
                <TextBlock Text="退出系统" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
        <!--left-->
        <StackPanel Grid.Row="1" Grid.Column="0" TextElement.FontSize="50">
            <Button Content="功能1" Width="200" Height="100" Background="LightGreen" Margin="10"/>
            <Button Content="功能2" Width="200" Height="80" Background="LightGreen" Margin="10"/>
            <Button Content="功能3" Width="200" Height="100" Background="LightGreen" Margin="10"/>
        </StackPanel>
        <!--bottom-->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Background="Orange">
            <TextBlock Text="这个公司研发" Margin="5"/>
        </StackPanel>
        <!--main-->
        <ContentControl Grid.Row="1" Grid.Column="1" Background="Red">
            <Button Background="Transparent" Content="Button" FontSize="40" Margin="20" />
        </ContentControl>
    </Grid>
</Window>

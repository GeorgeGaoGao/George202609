<Window x:Class="_55.ImageBrushExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_55.ImageBrushExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="500">
    <Grid Name="myGrid" MouseWheel="Grid_MouseWheel">
        <Grid.Background>
            <ImageBrush ImageSource="/001.jpg" Stretch="UniformToFill" TileMode="Tile">
                <ImageBrush.Viewport>
                    <Rect X="0.25" Y="0.25" Width="0.5" Height="0.5"/>
                </ImageBrush.Viewport>
            </ImageBrush>
        </Grid.Background>
    </Grid>
</Window>

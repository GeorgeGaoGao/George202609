<Window x:Class="_13.ProgressBarExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_13.ProgressBarExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <ProgressBar Name="myProgressBar" Minimum="0" Maximum="100" Value="0" Orientation="Horizontal" 
             Height="20" Margin="10"/>
        <TextBlock Text="{Binding ElementName=myProgressBar, Path=Value,StringFormat={}{0:0.00}%}" 
                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
</Window>

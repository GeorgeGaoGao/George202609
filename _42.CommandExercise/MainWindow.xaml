<Window x:Class="_42.CommandExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_42.CommandExercise"
        mc:Ignorable="d" 
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel>
        <Button Margin="3" Width="400" Height="40" Content="事件驱动模式" Click="Button_Click"/>
        <Button Margin="3" Width="400" Height="40" Command="{Binding ActionCommand}" Content="ActionCommand"/>
        <Button Margin="3" Width="400" Height="40" Command="{Binding ActionParamCommand}" 
                CommandParameter="   这是带入的参数" Content="ActionParamCommand"/>
        <Button Margin="3" Width="400" Height="40" Content="带入一个window" 
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"
                Command="{Binding windowCommand}">
            
        </Button>
    </StackPanel>
</Window>

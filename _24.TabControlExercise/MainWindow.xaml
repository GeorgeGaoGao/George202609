<Window x:Class="_24.TabControlExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_24.TabControlExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TabControl Name="myTabControl" Margin="30" SelectionChanged="myTabControl_SelectionChanged">
            <TabItem Header="首页" Width="120" FontSize="30">
                <Border Background="LightBlue">
                    <TextBlock Text="首页的界面" FontSize="50" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </TabItem>
            <TabItem Header="第二页" Width="100">
                <Border Background="LightBlue">
                    <TextBlock Text="第二页的界面" FontSize="50" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </TabItem>
        </TabControl>
        <TextBlock Name="myTextBlock" Grid.Row="1"/>
    </Grid>
</Window>

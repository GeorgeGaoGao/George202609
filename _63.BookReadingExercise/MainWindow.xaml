<Window x:Class="_63.BookReadingExercise.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_63.BookReadingExercise"
        mc:Ignorable="d"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        Title="{x:Static local:MainWindow._windowTitle}" Height="450" Width="800">
    <Window.Resources>
        <System:String x:Key="myString">
            today is a beautiful day!
        </System:String>
        <Style x:Key="{x:Type Button}"  TargetType="Button">
            <Style.Setters>
                <Setter Property="Width" Value="200"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Background" Value="Green"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Margin" Value="2"/>
            </Style.Setters>
        </Style>
    </Window.Resources>
    <StackPanel>
        <local:MyButton Style="{StaticResource {x:Type Button}}" Content="显示自己的窗口" UserWindowType="{x:Type local:MainWindow}"/>
        <Button Content="show string" Width="200" Height="40" Click="Button_Click"/>
        <Button Content="2nd button"/>
        <Button Content="3rd button" Style="{x:Null}"/>
        <ListBox>
            <ListBox.ItemsSource>
                <x:Array Type="{x:Type System:String}">
                    <System:String>George</System:String>
                    <System:String>Gao</System:String>
                    <System:String>GeorgeGao</System:String>
                </x:Array>
                
            </ListBox.ItemsSource>
        </ListBox>
        <ListBox>
            <CheckBox Content="tim"/>
            <CheckBox Content="tom"/>
            <CheckBox Content="george"/>
            <Button Content="Mess"/>
            <Button Content="WPF" Click="Button_Click_1"/>
        </ListBox>
        <TextBlock Text="{x:Static local:MainWindow.ShowText}" FontSize="30" Foreground="Green"/>
<!--这个rectangel在办公室的屏幕上宽度为132MM。按照物理尺寸一致的原则，它在家里屏幕上应也是这么宽。-->
        <Rectangle Width="500" Height="400" Stroke="Red" StrokeThickness="1"/>
    </StackPanel>
</Window>

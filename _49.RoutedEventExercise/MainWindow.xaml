<Window x:Class="_49.RoutedEventExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_49.RoutedEventExercise" xmlns:controls="clr-namespace:_49.RoutedEventExercise.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <controls:Widget Completed="Widget_Completed" Target="{Binding ElementName=targetSlider, Path=Value}"
                         Title="年度销售总额" Value="{Binding ElementName=mySlider, Path=Value}" Width="300" Height="150" BorderBrush="Red" Background="Green"/>
        <Slider Name="mySlider" Maximum="2000000" Value="0" Width="200" Height="30" Margin="0 50" IsSnapToTickEnabled="True"/>
        <Slider Name="targetSlider" Maximum="2000000" Value="10000" Width="200" Height="30" IsSnapToTickEnabled="True"/>
    </StackPanel>
</Window>

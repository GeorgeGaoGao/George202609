<Window x:Class="_57.DropShadowEffectExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_57.DropShadowEffectExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Name="myGrid" MouseMove="Grid_MouseMove" Background="Transparent">
        <Button Name="myButton" Width="200" Height="50" Content="Hello,Button!">
            <Button.Effect>
                <DropShadowEffect ShadowDepth="10" Color="Gray" BlurRadius="10" Direction="45"/>
            </Button.Effect>
        </Button>
    </Grid>
</Window>

<Window x:Class="_03.ContentControlExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_03.ContentControlExercise"
        xmlns:georgedll="clr-namespace:GeorgeWpfDLL;assembly=GeorgeWpfDLL"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
   
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0" ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" DisplayMemberPath="Name"/>
        <Button  Width="300" Height="150">
            <StackPanel>
                <TextBlock Text="hello world"/>
                <Rectangle Width="100" Height="50" Stroke="Red" StrokeThickness="2" Fill="Orange"/>
            </StackPanel>
        </Button>
        <ContentControl Grid.Column="1" Background="Red" Margin="20" Foreground="White" Content="{Binding SelectedPerson}">
            <ContentControl.ContentTemplate>
                <DataTemplate >
                    <Border Background="Red" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" CornerRadius="20">
                        <StackPanel >
                            <TextBlock Text="{Binding Age}"/>
                            <TextBlock Text="{Binding Path=Address}"/>
                            <TextBlock Text="{Binding Path=Name}"/>
                        </StackPanel>
                        <!--<TextBlock Text="{Binding .}" FontSize="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
                    </Border>  
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</Window>

<Window x:Class="_18.MediaElement2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_18.MediaElement2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <MediaElement Name="myMediaElement" LoadedBehavior="Manual"/>
        <Border Name="maskBorder" Background="Black" >
            <TextBlock Name="maskTextBlock" Text="媒体播放器 | MediaElement" 
                       Foreground="LightCoral" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel  Orientation="Horizontal" Height="30" Grid.Row="1" Margin="3">
            <Button Content="打开" Width="100" Margin="3" Click="OpenMedia"/>
            <Button Content="播放" Width="100" Margin="3" Click="PlayMedia"/>
            <Button Content="暂停" Width="100" Margin="3" Click="PauseMedia"/>
            <Button Content="后退" Width="100" Margin="3" Click="BackwardMedia"/>
            <Button Content="前进" Width="100" Margin="3" Click="ForwardMedia"/>
            <Rectangle Width="50" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="音量" Width="30"/>
                <Slider Name="mySlider" ValueChanged="Slider_ValueChanged" Width="150" Minimum="0" Maximum="10" Value="0"/>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2">
            <ProgressBar Name="myProgressBar" Minimum="0" Height="10" Margin="5"/>
        </Grid>
    </Grid>
</Window>

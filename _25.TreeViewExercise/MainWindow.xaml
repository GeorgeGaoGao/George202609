<Window x:Class="_25.TreeViewExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_25.TreeViewExercise"
        mc:Ignorable="d" FontSize="20"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" >
            <TextBlock Text="根目录"  Margin="3"/>
            <TextBox Name="myTextBox" Width="400" Margin="3"/>
            <Button Content="选择目录" MinWidth="100" Click="Button_Click" Margin="3"/>
        </StackPanel>
        <TreeView Grid.Row="1" Name="myTreeView" SelectedItemChanged="myTreeView_SelectedItemChanged"/>
    </Grid>
</Window>

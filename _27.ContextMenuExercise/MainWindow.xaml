<Window x:Class="_27.ContextMenuExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_27.ContextMenuExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Name="myGrid">
        <Border Width="300" Height="200" CornerRadius="15" Background="LightBlue">
            <Border.ContextMenu>
                <ContextMenu Name="myContextMemu" PlacementTarget="{Binding ElementName=myGrid}" 
                             VerticalOffset="-200" HorizontalOffset="-200">
                    <MenuItem Header="打开" Click="MenuItem_Click"/>
                    <MenuItem Header="关闭"/>
                    <MenuItem Header="复制"/>
                    <MenuItem Header="粘贴"/>
                    <MenuItem Header="清空上下文菜单" >
                        <MenuItem Header="关于上一版本"/>
                        <MenuItem Header="清空上下文菜单" Click="MenuItem_Click_Clear"/>
                    </MenuItem>
                              
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
    </Grid>
</Window>

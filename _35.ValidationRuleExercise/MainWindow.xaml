<Window x:Class="_35.ValidationRuleExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_35.ValidationRuleExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel Grid.Column="1" >
        <TextBox  Margin="5">
            <TextBox.Text>
                <Binding Path="Person.Name">
                    <Binding.ValidationRules>
                        <local:NameValidationRule ValidatesOnTargetUpdated="True"/>
                    </Binding.ValidationRules>
                </Binding>
                
            </TextBox.Text>
        </TextBox>
        <TextBox Text="{Binding Person.Age,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
        <TextBox Text="{Binding Person.Address,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
        <TextBox Text="{Binding Person.Money,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
        <TextBlock Text="{Binding Person.Name}"/>
        <TextBlock Text="{Binding Person.Age}"/>
        <TextBlock Text="{Binding Person.Address}"/>
        <TextBlock Text="称号:  ">
       
        </TextBlock>
        <Button Content="change" Width="200" Height="30" />
    </StackPanel>
</Window>

<Window x:Class="_39.ControlTemplateExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_39.ControlTemplateExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <ControlTemplate x:Key="ButtonControlTemplate" TargetType="Button">
            <Border Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Green" BorderThickness="1">
                <ContentPresenter TextElement.Foreground="White" TextElement.FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <StackPanel>
            <Button Name="myButton01" Background="LightGreen"  Width="200" Height="40" Margin="5">
                <Button.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="这是button的上一行"/>
                        <TextBlock Text="这是button的下一行" Grid.Row="1"/>
                    </Grid>
                </Button.Content>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="templateBorder" Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                            BorderBrush="Green" BorderThickness="1">
                            <ContentPresenter Name="templateContentPresenter" TextElement.Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="templateBorder" Value="Blue"/>
                                <Setter Property="Content" TargetName="templateContentPresenter" Value="Mouse entering"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Background="LightBlue"  Content="第2个Button" Width="200" Height="40" Margin="5" Template="{StaticResource ButtonControlTemplate}"/>


            <Button Content="第3个Button" Width="200" Height="40" Margin="5" Template="{StaticResource AppControlTemplateForButton}"/>
            <Button Style="{StaticResource ButtonStyleUsingFile}" Content="第4个Button" Width="200" Height="40" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>

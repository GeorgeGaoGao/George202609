<Window x:Class="_47.AttachedPropertyExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_47.AttachedPropertyExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <StackPanel Margin="50">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10" Text="姓名："/>
                <TextBox Margin="10" Text="{Binding Person.UserName}" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10" Text="密码："/>
                <PasswordBox Margin="10" local:PasswordHelper.Password="{Binding Person.Password,Mode=TwoWay}" Width="200"/>
            </StackPanel>
            <Button Margin="100 0" Click="Button_Click" Width="100" Height="50" Content="Login"/>
        </StackPanel>
    </Grid>
</Window>

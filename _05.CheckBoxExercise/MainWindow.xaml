<Window x:Class="_05.CheckBoxExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_05.CheckBoxExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
            <TextBlock Text="请选择菜品"/>
            <RadioButton GroupName="1" Content="清椒肉丝1" Name="checkbox1"/>
            <RadioButton GroupName="1" Content="清椒肉丝2" Name="checkbox2"/>
            <RadioButton GroupName="2" Content="清椒肉丝3" Name="checkbox3"/>
            <RadioButton GroupName="3" Content="清椒肉丝4" Name="checkbox4"/>
            <Button Content="查看菜单" Click="Button_Click"/>
            <RepeatButton Content="重复按钮" Delay="1000" Interval="500" Click="RepeatButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

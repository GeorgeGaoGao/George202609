<Window x:Class="_16.ExpanderExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_16.ExpanderExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Expander用法"/>
        <Expander  ExpandDirection="Up">
            <TextBlock TextWrapping="Wrap" >
                这个方案通过 SelectedDatesChanged 事件实时显示选择结果，用户选择日期时就能看到反馈，点击"确定选择"按钮时只是确认操作，这样用户体验更好，也不会出现点击无反应的问题。
            </TextBlock>
            <Expander.Style>
                <Style TargetType="Expander">
                    <Style.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter Property="Header" Value="收起"/>
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter Property="Header" Value="打开"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Expander.Style>
        </Expander>
    </StackPanel>
</Window>

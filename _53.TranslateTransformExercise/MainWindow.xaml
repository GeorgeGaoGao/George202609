<Window x:Class="_53.TranslateTransformExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_53.TranslateTransformExercise"
        mc:Ignorable="d" MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp" MouseDown="Window_MouseDown"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Name="myButton" Width="100" Height="30" Content="button" >
            <Button.RenderTransform>
                <TranslateTransform></TranslateTransform>
            </Button.RenderTransform>
        </Button>
    </Grid>
</Window>

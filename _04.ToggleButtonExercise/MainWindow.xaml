        <ToggleButton 
              Click="ToggleButton_Click" IsThreeState="True">
            <Border Width="100" Height="100" BorderBrush="DarkGreen" BorderThickness="5">
                <TextBlock Text="电源开关" FontSize="40" Foreground="Green" 
                   VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="3" Color="Gray" BlurRadius="2"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>
        </ToggleButton>
    </Grid>
</Window>

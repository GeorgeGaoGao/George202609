<Window x:Class="_66.CommandExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_66.CommandExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Name="myStackpanel">
        <TextBox x:Name="myTextBox" Width="200" Height="50"/>
        <Button x:Name="myButton" Width="200" Height="50" Margin="10" Content="Clear"/>
    </StackPanel>
</Window>

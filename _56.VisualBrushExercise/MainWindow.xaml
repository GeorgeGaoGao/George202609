<Window x:Class="_56.VisualBrushExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_56.VisualBrushExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Image MouseEnter="myImage_MouseEnter"
                   MouseLeave="myImage_MouseLeave"
                   MouseMove="myImage_MouseMove"
                   Name="myImage" Source="/001.jpg"/>
            <Canvas Name="myCanvas" IsHitTestVisible="False">
                <Ellipse Name="myEllipse" Width="200" Height="200" Stroke="Red" StrokeThickness="1" Tag="3">
                    <Ellipse.Fill>
                        <VisualBrush x:Name="myVisualBrush" Visual="{Binding ElementName=myImage}" ViewboxUnits="Absolute"/>
                    </Ellipse.Fill>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Canvas>

        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBox Width="400" Height="30" VerticalContentAlignment="Center" >
                <TextBox.Resources>
                    <VisualBrush x:Key="waterTextVisualBrush" Opacity="0.5" Stretch="None"
                                 AlignmentX="Left">
                        <VisualBrush.Visual>
                            <TextBlock Text="请输入画家姓名或画作名称"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </TextBox.Resources>
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Background" Value="{StaticResource waterTextVisualBrush}"/>
                            </Trigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource waterTextVisualBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
               
            </TextBox>
            <Button Content="搜索画作" Margin="5" Height="30"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="_45.DependencyPropertyExercise.Controls.Widget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:_45.DependencyPropertyExercise.Controls"
             mc:Ignorable="d" FontSize="30"
             Name="myUserControl" Foreground="#666666" BorderBrush="#8cddcd" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderBrush="{Binding ElementName=myUserControl, Path=BorderBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Setters>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="0 3 0 0"/>
                    <Setter Property="Margin" Value="5"/>
                </Style.Setters>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#f7f9f9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ElementName=myUserControl,Path=Value}" 
                       FontSize="{Binding ElementName=myUserControl,Path=FontSize}"
                       Foreground="{Binding ElementName=myUserControl,Path=Foreground}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ElementName=myUserControl,Path=Title}"
                       FontSize="14" Foreground="{Binding ElementName=myUserControl,Path=Foreground}"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ElementName=myUserControl,Path=Icon}"
                       FontSize="26" Foreground="{Binding ElementName=myUserControl,Path=BorderBrush}"
                       Grid.RowSpan="2" VerticalAlignment="Center"/>

        </Grid>

    </Border>


</UserControl>

<Window x:Class="_45.DependencyPropertyExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_45.DependencyPropertyExercise" xmlns:controls="clr-namespace:_45.DependencyPropertyExercise.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <controls:Widget Title="{Binding Title}" Icon="{Binding Icon}"  Width="300" Height="150"/>
            <controls:Widget Title="年度销售总额" Value="1234.56元" Icon="$" Width="300" Height="150" BorderBrush="Red" Background="Green"/>
            
        </StackPanel>
        <Grid>
            <controls:TrayControl Count="60"/>
        </Grid>
    </StackPanel>

   
</Window>

<Window x:Class="_34.BindingExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_34.BindingExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <local:AgeToBrushConverter x:Key="AgeToBrushConverter"/>
        <local:AgeMoneyMultiConverter x:Key="AgeMoneyMultiConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" Background="{Binding Person.Age,Converter={StaticResource AgeToBrushConverter},ConverterParameter=999}">
            <TextBox Text="{Binding Person.Name,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <TextBox Text="{Binding Person.Age,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <TextBox Text="{Binding Person.Address,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <TextBox Text="{Binding Person.Money,UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <TextBlock Text="{Binding Person.Name}"/>
            <TextBlock Text="{Binding Person.Age}"/>
            <TextBlock Text="{Binding Person.Address}"/>
            <TextBlock Text="称号:  ">
                <Run>
                    <Run.Text>
                        <MultiBinding Converter="{StaticResource AgeMoneyMultiConverter}">
                            <Binding Path="Person.Age"/>
                            <Binding Path="Person.Money"/>
                        </MultiBinding>
                    </Run.Text>
                </Run>
            </TextBlock> 
            <Button Content="change" Width="200" Height="30" Click="Button_Click"/>
        </StackPanel>
        <ListView Background="LightCoral" ItemsSource="{Binding People}" SelectedItem="{Binding Person}">
            <ListView.View>
                <GridView>
                    <GridView.Columns>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Age" DisplayMemberBinding="{Binding Age}"/>
                        <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}"/>
                        <GridViewColumn Header="Money" DisplayMemberBinding="{Binding Money}"/>

                    </GridView.Columns>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
   
</Window>

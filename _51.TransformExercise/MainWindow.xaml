<Window x:Class="_51.TransformExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_51.TransformExercise"
        mc:Ignorable="d" MouseMove="Window_MouseMove"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
         <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Content="RotateTransform"  Width="100" Height="30"
        VerticalAlignment="Center" HorizontalAlignment="Center"
        >
            <Button.RenderTransform>
                <RotateTransform Angle="{Binding ElementName=mySlider, Path=Value}" CenterX="50" CenterY="15"/>
            </Button.RenderTransform>   
        </Button>
        <Button Grid.Column="1" Content="RotateTransform"  Width="100" Height="30"
        VerticalAlignment="Center" HorizontalAlignment="Center"
        >
            <Button.RenderTransform>
                <RotateTransform Angle="45"/>
            </Button.RenderTransform>   
        </Button>
        <Button Name="myButton" Grid.Column="2" Content="RotateTransform"  Width="100" Height="30"
        VerticalAlignment="Center" HorizontalAlignment="Center"
        >
            <Button.RenderTransform>
                <RotateTransform Angle="45"/>
            </Button.RenderTransform>   
        </Button>
        <Slider Name="mySlider" Width="400" Height="30" Maximum="720" Value="0" VerticalAlignment="Bottom" Margin="10" Grid.Column="0" Grid.ColumnSpan="3"/>
    </Grid>
         <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Content="ScaleTransform"  Width="100" Height="30"
        VerticalAlignment="Center" HorizontalAlignment="Center"
        >
            <Button.RenderTransform>
                <ScaleTransform ScaleX="{Binding ElementName=mySliderScale,Path=Value}" ScaleY="{Binding ElementName=mySliderScale, Path=Value}" CenterX="50" CenterY="15"  />
            </Button.RenderTransform>   
        </Button>
            <Button Grid.Column="1" Content="ScaleTransform"  Width="100" Height="30"
        VerticalAlignment="Center" HorizontalAlignment="Center"
        >
            <Button.RenderTransform>
                <RotateTransform Angle="45"/>
            </Button.RenderTransform>   
        </Button>
            <Button Name="myButtonScale" Grid.Column="2" Content="ScaleTransform"  Width="100" Height="30"
        VerticalAlignment="Center" HorizontalAlignment="Center"
        >
            <Button.RenderTransform>
                <RotateTransform Angle="45"/>
            </Button.RenderTransform>   
        </Button>
        <Slider Name="mySliderScale" Width="400" Height="30" Maximum="2" Value="0.1" VerticalAlignment="Bottom" Margin="10" Grid.Column="0" Grid.ColumnSpan="3"/>
    </Grid>
    </Grid>
   
</Window>

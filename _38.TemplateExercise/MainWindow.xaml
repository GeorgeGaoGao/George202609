<Window x:Class="_38.TemplateExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_38.TemplateExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Name="myLeftBorder" Width="188" Background="LightCyan">
            <StackPanel>
                <Button Click="Button_Click" Padding="3" Content="当前逻辑树" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Button Click="Button_Click_Visual" Padding="3" Content="当前视觉树" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>

        </Border>
        <Border Name="myRightBorder" Grid.Column="1" >
            <TreeView  Name="myTreeView" Margin="5"/>
        </Border>
    </Grid>
</Window>

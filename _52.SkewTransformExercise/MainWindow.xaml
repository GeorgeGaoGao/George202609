<Window x:Class="_52.SkewTransformExercise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_52.SkewTransformExercise"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Name="myButton" Width="100" Height="30" VerticalAlignment="Center" HorizontalAlignment="Center" Content="button" >
            <Button.RenderTransform>
                <SkewTransform AngleX="{Binding ElementName=mySlider, Path=Value}"/>
            </Button.RenderTransform>
        </Button>
        <TextBlock Name="myTextBlock" Width="400" Height="30" Margin="10" Text="{Binding ElementName=mySlider,Path=Value}"
                   Grid.Column="0" Grid.ColumnSpan="3" />
        <Slider Name="mySlider" IsSnapToTickEnabled="True" Minimum="-180" Maximum="180" Width="400" Height="30" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Margin="10"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>
